# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=
# Public host name of the admin frontend; Caddy gets its Let's Encrypt certificate for it (D-023).
# On the laptop: localhost (Caddy's own local certificate; the browser warns once, D-039).
PUBLIC_HOST=
# Optional: host port for HTTP (default 80). Set e.g. 8080 when Windows reserves port 80
# (netsh interface ipv4 show excludedportrange protocol=tcp); HTTPS stays on 443.
HTTP_PORT=
# At least 32 random characters
JWT_KEY=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_POSTALCODE=
COMPANY_CITY=
COMPANY_VATNUMBER=
COMPANY_COC=
COMPANY_IBAN=
COMPANY_EMAIL=
