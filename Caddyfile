# Reverse proxy for the admin frontend (D-023, REQ-025).
# The only service with published ports. Caddy gets and renews a Let's Encrypt certificate
# for PUBLIC_HOST automatically and redirects HTTP to HTTPS. It sets X-Forwarded-For and
# X-Forwarded-Proto; the frontend trusts them only from this proxy (ForwardedHeaders:KnownProxies).
{$PUBLIC_HOST} {
	encode zstd gzip
	reverse_proxy web:8080
}
