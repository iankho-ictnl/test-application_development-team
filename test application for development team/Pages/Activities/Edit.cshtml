@page "{id:int?}"
@model test_application_for_development_team.Pages.Activities.EditModel
@{
    ViewData["Title"] = Model.Id is null ? L["New activity"] : L["Edit activity"];
}
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-2">
        <label asp-for="Input.AssetId" class="form-label"></label>
        <select asp-for="Input.AssetId" asp-items="Model.Assets" class="form-select"><option value="0">--</option></select>
    </div>
    <div class="row">
        <div class="col mb-2">
            <label asp-for="Input.Date" class="form-label"></label>
            <input asp-for="Input.Date" class="form-control" />
        </div>
        <div class="col mb-2">
            <label asp-for="Input.Kind" class="form-label"></label>
            <select asp-for="Input.Kind" asp-items="Model.Kinds" class="form-select"></select>
        </div>
    </div>
    <div class="mb-2">
        <label asp-for="Input.Description" class="form-label"></label>
        <input asp-for="Input.Description" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Input.PricingType" class="form-label"></label>
        <select asp-for="Input.PricingType" asp-items="Model.PricingTypes" class="form-select" id="pricingType"></select>
    </div>
    <div class="row" id="hourly">
        <div class="col mb-2">
            <label asp-for="Input.Hours" class="form-label"></label>
            <input asp-for="Input.Hours" class="form-control" inputmode="decimal" />
        </div>
        <div class="col mb-2">
            <label asp-for="Input.HourlyRate" class="form-label"></label>
            <input asp-for="Input.HourlyRate" class="form-control" inputmode="decimal" />
        </div>
    </div>
    <div class="mb-2" id="fixed">
        <label asp-for="Input.FixedPrice" class="form-label"></label>
        <input asp-for="Input.FixedPrice" class="form-control" inputmode="decimal" />
    </div>
    <div class="mb-3">
        <label asp-for="Input.VatRateName" class="form-label"></label>
        <select asp-for="Input.VatRateName" asp-items="Model.VatRates" class="form-select"></select>
    </div>
    <button type="submit" class="btn btn-primary">@L["Save"]</button>
    <a asp-page="Index" class="btn btn-link">@L["Cancel"]</a>
</form>
@if (Model.Id is int id)
{
    <form method="post" asp-page-handler="Delete" asp-route-id="@id" class="mt-3" onsubmit="return confirm('@L["Are you sure?"]');">
        <button type="submit" class="btn btn-outline-danger">@L["Delete"]</button>
    </form>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const select = document.getElementById('pricingType');
            const toggle = () => {
                const hourly = select.value === 'Hourly';
                document.getElementById('hourly').style.display = hourly ? '' : 'none';
                document.getElementById('fixed').style.display = hourly ? 'none' : '';
            };
            select.addEventListener('change', toggle);
            toggle();
        })();
    </script>
}
