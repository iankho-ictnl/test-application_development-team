@page
@model test_application_for_development_team.Pages.Account.LoginModel
@{
    ViewData["Title"] = L["Sign in"];
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-3">@L["Sign in"]</h1>
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="UserName" class="form-label"></label>
                <input asp-for="UserName" class="form-control" autocomplete="username" autofocus />
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-primary">@L["Sign in"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
