@page
@model test_application_for_development_team.Pages.Account.LoginTwoFactorModel
@{
    ViewData["Title"] = L["Two-factor sign-in"];
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-3">@L["Two-factor sign-in"]</h1>
        <p>@L["Enter the code from your authenticator app."]</p>
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="Challenge" />
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" autocomplete="one-time-code" inputmode="numeric" autofocus />
            </div>
            <button type="submit" class="btn btn-primary">@L["Sign in"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
