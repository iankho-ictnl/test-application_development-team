@using System.Globalization
@using Microsoft.AspNetCore.Builder
@using Microsoft.Extensions.Options
@inject IOptions<RequestLocalizationOptions> LocOptions
@{
    var user = User;
    var signedIn = user.Identity?.IsAuthenticated == true;
    var currentCulture = CultureInfo.CurrentUICulture.Name;
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @L["Property administration"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/test_application_for_development_team.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">@L["Property administration"]</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="@L["Toggle navigation"]">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (signedIn && user.Has(Permissions.ReadAll))
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Owners/Index">@L["Owners"]</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Assets/Index">@L["Assets"]</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Expenses/Index">@L["Expenses"]</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Activities/Index">@L["Activities"]</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Invoices/Index">@L["Invoices"]</a></li>
                        }
                        @if (signedIn && user.Has(Permissions.Reports))
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Reports">@L["Reports"]</a></li>
                        }
                        @if (signedIn && (user.Has(Permissions.VatRates) || user.Has(Permissions.ReadAll)))
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/VatRates/Index">@L["VAT rates"]</a></li>
                        }
                        @if (signedIn && user.Has(Permissions.Users))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">@L["Management"]</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-page="/Admin/Users/Index">@L["Users"]</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/Roles">@L["Roles and permissions"]</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <form method="post" asp-page="/Account/Culture" class="d-flex me-2">
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <select name="culture" class="form-select form-select-sm" onchange="this.form.submit()" aria-label="@L["Language"]">
                            @foreach (var c in LocOptions.Value.SupportedUICultures!)
                            {
                                <option value="@c.Name" selected="@(c.Name == currentCulture)">@c.NativeName</option>
                            }
                        </select>
                    </form>
                    @if (signedIn)
                    {
                        <ul class="navbar-nav">
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Profile">@user.Identity!.Name</a></li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Account/Logout">
                                    <button type="submit" class="btn btn-link nav-link text-dark">@L["Sign out"]</button>
                                </form>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Message"] is string message)
            {
                <div class="alert alert-success">@message</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">&copy; @DateTime.Now.Year - @L["Property administration"]</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

